{
  "name": "@deva00/nightshift",
  "version": "0.4.0",
  "description": "Let Claude Code work through your todo list unattended: one fresh session per item, a pull request, an independent review, green CI, a normal merge, and a handoff to the next session.",
  "keywords": [
    "claude",
    "claude-code",
    "agent",
    "automation",
    "pull-request",
    "code-review",
    "todo"
  ],
  "license": "MIT",
  "author": "Deva Annamaraju",
  "homepage": "https://github.com/ya-nsh/nightshift#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ya-nsh/nightshift.git"
  },
  "bugs": "https://github.com/ya-nsh/nightshift/issues",
  "type": "module",
  "bin": {
    "nightshift": "dist/cli.js"
  },
  "files": [
    "dist",
    "prompts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test",
    "prepublishOnly": "npm run check && npm run build",
    "prepare": "npm run build"
  },
  "dependencies": {
    "smol-toml": "^1.9.1",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@anthropic-ai/claude-agent-sdk": ">=0.3.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/claude-agent-sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
